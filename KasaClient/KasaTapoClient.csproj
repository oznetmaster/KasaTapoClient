<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>KasaTapoClient</RootNamespace>
		<AssemblyName>KasaTapoClient</AssemblyName>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<TargetFrameworks>net472;net10.0</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<PackageId>KasaTapoClient</PackageId>
		<Version>2.1.0</Version>
		<Authors>Neil Colvin</Authors>
		<Company>Neil Colvin</Company>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>kasa;api;library</PackageTags>
		<RepositoryUrl>https://github.com/oznetmaster/KasaTapoClient</RepositoryUrl>
		<PackageProjectUrl>https://github.com/oznetmaster/KasaTapoClient</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>Reusable Kasa/Tapo client library for .NET Framework 4.7.2 and .NET 10.</Description>
		<PackageReleaseNotes># KasaTapoClient 2.1.0

This minor release adds optional lighting configuration and fixes KLAP authentication for updated legacy devices. Existing public APIs remain compatible.

## Added

- **Physical strip length:** `LightStripSegment` provides typed state and `SetSegmentCountAsync` for devices advertising the `segment` component. Configure 0–50 segments of 10 cm per run. This is separate from lighting-effect segment arrays and does not configure individual segment colors.
- **Fade between settings:** `LightTransition.ChangeTransitionEnabled` and `SetChangeTransitionEnabledAsync` control fading between brightness or color settings while a light is on. Existing turn-on and turn-off durations are preserved. A nullable value distinguishes unavailable state from a supported but disabled setting.
- **Console support:** `host &lt;address&gt; light segments &lt;0-50&gt;` and `host &lt;address&gt; light transition-change &lt;on|off&gt;`, with corresponding status output. Existing command abbreviations retain their meaning.

Both new setters check reported capabilities, honor cancellation, report device rejection and refresh typed state after successful writes.

## Fixed

- Legacy IOT.KLAP devices advertising login version 2 or later now use KLAP v2 authentication. Legacy devices with no login version or an older version retain v1 authentication; SMART-family KLAP behavior is unchanged.

## Compatibility

- No existing public signatures were removed or changed. No new raw JSON API was introduced.
- Targets remain .NET 10 and .NET Framework 4.7.2. Runtime dependencies are unchanged.
- Existing thermostat `States` lists continue to preserve hold, summer-mode and other TRV flags.

## Validation

- All 169 offline tests pass on each supported runtime.
- Microsoft APICompat reports no breaking public API changes against the released 2.0.1 package on either target, including parameter-name and attribute checks.
- Live fade-on-change write, readback and restoration passed on L900 and L530 devices under both runtimes. Console builds passed for both targets.
- Legacy IOT.KLAP v2 and physical strip-length configuration have deterministic offline coverage; matching hardware was unavailable for live validation.</PackageReleaseNotes>
		<!-- brings in System.Net.Http -->
		<LangVersion>13.0</LangVersion>
		<Nullable>enable</Nullable>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
		<!-- Treat missing XML docs as errors in Release -->
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
		<!-- Disable deterministic so timestamps differ (useful if stamping versions externally) -->
		<Deterministic>false</Deterministic>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<Reference Include="System.Configuration" />
		<Reference Include="System.Data.DataSetExtensions" />
		<Reference Include="Microsoft.CSharp" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
		<PackageReference Include="System.Text.Json" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="" />
		<None Include="..\MIGRATION-2.0.md" Pack="true" PackagePath="" />
		<None Include="..\CHANGELOG.md" Pack="true" PackagePath="" />
		<None Include="..\RELEASE_NOTES.md" Pack="true" PackagePath="" />
		<None Include="..\KasaClient.Tests\README.md" Pack="true" PackagePath="KasaClient.Tests/" />
		<None Include="..\LICENSE" Pack="true" PackagePath="" />
		<None Include="..\ATTRIBUTIONS.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="KasaClient.Tests" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<PackageReference Include="IsExternalInit" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
		<PackageReference Include="System.Memory" Version="4.6.3" />
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Properties\" />
	</ItemGroup>

	<!-- Detect docfx.exe from docfx.console package or global dotnet tool -->
	<Choose>
		<When Condition="Exists('$(USERPROFILE)\.dotnet\tools\docfx.exe')">
			<PropertyGroup>
				<DocfxExe>$(USERPROFILE)\.dotnet\tools\docfx.exe</DocfxExe>
			</PropertyGroup>
		</When>
		<When Condition="Exists('C:\ProgramData\chocolatey\bin\docfx.exe')">
			<PropertyGroup>
				<DocfxExe>C:\ProgramData\chocolatey\bin\docfx.exe</DocfxExe>
			</PropertyGroup>
		</When>
		<When Condition="Exists('$(Pkgdocfx_console)\tools\docfx.exe')">
			<PropertyGroup>
				<DocfxExe>$(Pkgdocfx_console)\tools\docfx.exe</DocfxExe>
			</PropertyGroup>
		</When>
		<Otherwise>
			<PropertyGroup>
				<DocfxExe></DocfxExe>
			</PropertyGroup>
		</Otherwise>
	</Choose>

	<Target Name="GenerateDocfxDoc" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net472'">
		<PropertyGroup>
			<DocsDir>$(MSBuildProjectDirectory)\docs</DocsDir>
			<DocfxConfig>$(MSBuildProjectDirectory)\docfx\docfx.json</DocfxConfig>
		</PropertyGroup>

		<Warning Text="DOCFX: DocFX not found. Skipping docs." Condition="'$(DocfxExe)' == ''" />
		<Warning Text="DOCFX: docfx.json not found at '$(DocfxConfig)'. Skipping docs." Condition="'$(DocfxExe)' != '' and !Exists('$(DocfxConfig)')" />

		<!--1) Metadata -->
		<Message Importance="high" Text="DOCFX: Generating metadata from $(DocfxConfig)" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />
		<Exec Command="&quot;$(DocfxExe)&quot; metadata &quot;$(DocfxConfig)&quot;" ContinueOnError="true" IgnoreExitCode="true" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />

		<!--2) Build site directly into docs -->
		<Message Importance="high" Text="DOCFX: Building site to $(DocsDir)" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />
		<RemoveDir Directories="$(DocsDir)" Condition="Exists('$(DocsDir)')" />
		<MakeDir Directories="$(DocsDir)" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />
		<Exec Command="&quot;$(DocfxExe)&quot; build &quot;$(DocfxConfig)&quot; --output &quot;$(DocsDir)&quot; --logLevel Error --noLangKeyword true --markdownEngineName markdig" ContinueOnError="true" IgnoreExitCode="true" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />

	</Target>
</Project>
