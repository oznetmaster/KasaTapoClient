<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>KasaTapoClient</RootNamespace>
		<AssemblyName>KasaTapoClient</AssemblyName>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<TargetFrameworks>net472;net10.0</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<PackageId>KasaTapoClient</PackageId>
		<Version>1.3.1</Version>
		<Authors>Neil Colvin</Authors>
		<Company>Neil Colvin</Company>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>kasa;api;library</PackageTags>
		<RepositoryUrl>https://github.com/oznetmaster/KasaTapoClient</RepositoryUrl>
		<PackageProjectUrl>https://github.com/oznetmaster/KasaTapoClient</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>Reusable Kasa/Tapo client library for .NET Framework 4.7.2 and .NET 10.</Description>
		<PackageReleaseNotes>Brightness control is now gated on the capability a device actually advertises rather than on DeviceType. SupportsLightControl has been split into SupportsBrightnessControl, SupportsColorControl, and SupportsColorTemperatureControl; brightness is permitted whenever the device is a bulb or light strip, or when a SMART-protocol device negotiates the brightness component. SetBrightnessAsync consequently works on SMART dimmers and dimmable switches that were previously refused, including KS225, KS240, P135, S500D, S505D, S515D, and HS220 hardware revision 3.26. Color temperature and HSV remain restricted to bulbs and light strips, and legacy (IOT) dimmer on/off continues to use system.set_relay_state rather than the smartbulb lighting service. Keying on the negotiated component rather than the device type also covers devices that dim but are never classified as DeviceType.Dimmer. KS240 reports SMART.KASASWITCH with a child_device component and classifies as WallSwitch; P135 reports SMART.TAPOPLUG and classifies as Plug. Both advertise brightness and both are now controllable. This classification behavior is unchanged and matches the reference implementation. Light-state parameters are now validated individually, so an unsupported request reports the specific capability that is missing - does not support brightness control, does not support color-temperature control, or does not support color control - instead of the single does not support light-state control message used previously. The exception type is unchanged (InvalidOperationException); only the message text is more specific. A light-state call specifying no parameters at all now throws ArgumentException rather than composing an empty request. Added dimmer coverage in DimmerRegressionTests and DimmerSupportTests, covering the SMART brightness path, color-temperature and HSV refusal on dimmers, the KS240 and P135 classification cases, and the legacy dimmer on/off guard. Behavior was additionally validated against KS225 hardware (brightness accepted) and KS205 hardware (brightness refused locally, with no request sent, as it advertises no brightness component).</PackageReleaseNotes>
		<!-- brings in System.Net.Http -->
		<LangVersion>13.0</LangVersion>
		<Nullable>enable</Nullable>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
		<!-- Treat missing XML docs as errors in Release -->
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
		<!-- Disable deterministic so timestamps differ (useful if stamping versions externally) -->
		<Deterministic>false</Deterministic>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<Reference Include="System.Configuration" />
		<Reference Include="System.Data.DataSetExtensions" />
		<Reference Include="Microsoft.CSharp" />
	</ItemGroup>

	<!-- DEBUG-only: exposes internal discovery diagnostics to the Crestron driver for local debugging.
		  Never present in the Release/NuGet-published assembly. -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<InternalsVisibleTo Include="KasaTapoCrestronDriver" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
		<PackageReference Include="log4net" Version="3.3.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="" />
		<None Include="..\LICENSE" Pack="true" PackagePath="" />
		<None Include="..\ATTRIBUTIONS.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="KasaClient.Tests" />
		<InternalsVisibleTo Include="KasaTapoCrestronDriver.Tests" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<PackageReference Include="IsExternalInit" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
		<PackageReference Include="System.Memory" Version="4.6.3" />
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Properties\" />
	</ItemGroup>

	<!-- Detect docfx.exe from docfx.console package or global dotnet tool -->
	<Choose>
		<When Condition="Exists('$(USERPROFILE)\.dotnet\tools\docfx.exe')">
			<PropertyGroup>
				<DocfxExe>$(USERPROFILE)\.dotnet\tools\docfx.exe</DocfxExe>
			</PropertyGroup>
		</When>
		<When Condition="Exists('C:\ProgramData\chocolatey\bin\docfx.exe')">
			<PropertyGroup>
				<DocfxExe>C:\ProgramData\chocolatey\bin\docfx.exe</DocfxExe>
			</PropertyGroup>
		</When>
		<When Condition="Exists('$(Pkgdocfx_console)\tools\docfx.exe')">
			<PropertyGroup>
				<DocfxExe>$(Pkgdocfx_console)\tools\docfx.exe</DocfxExe>
			</PropertyGroup>
		</When>
		<Otherwise>
			<PropertyGroup>
				<DocfxExe></DocfxExe>
			</PropertyGroup>
		</Otherwise>
	</Choose>

	<Target Name="GenerateDocfxDoc" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net472'">
		<PropertyGroup>
			<DocsDir>$(MSBuildProjectDirectory)\docs</DocsDir>
			<DocfxConfig>$(MSBuildProjectDirectory)\docfx\docfx.json</DocfxConfig>
		</PropertyGroup>

		<Warning Text="DOCFX: DocFX not found. Skipping docs." Condition="'$(DocfxExe)' == ''" />
		<Warning Text="DOCFX: docfx.json not found at '$(DocfxConfig)'. Skipping docs." Condition="'$(DocfxExe)' != '' and !Exists('$(DocfxConfig)')" />

		<!--1) Metadata -->
		<Message Importance="high" Text="DOCFX: Generating metadata from $(DocfxConfig)" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />
		<Exec Command="&quot;$(DocfxExe)&quot; metadata &quot;$(DocfxConfig)&quot;" ContinueOnError="true" IgnoreExitCode="true" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />

		<!--2) Build site directly into docs -->
		<Message Importance="high" Text="DOCFX: Building site to $(DocsDir)" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />
		<RemoveDir Directories="$(DocsDir)" Condition="Exists('$(DocsDir)')" />
		<MakeDir Directories="$(DocsDir)" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />
		<Exec Command="&quot;$(DocfxExe)&quot; build &quot;$(DocfxConfig)&quot; --output &quot;$(DocsDir)&quot; --logLevel Error --noLangKeyword true --markdownEngineName markdig" ContinueOnError="true" IgnoreExitCode="true" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />

	</Target>
</Project>
