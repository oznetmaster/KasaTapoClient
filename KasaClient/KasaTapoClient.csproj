<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>KasaTapoClient</RootNamespace>
		<AssemblyName>KasaTapoClient</AssemblyName>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<TargetFrameworks>net472;net10.0</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<PackageId>KasaTapoClient</PackageId>
		<Version>2.2.2</Version>
		<Authors>Neil Colvin</Authors>
		<Company>Neil Colvin</Company>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>kasa;api;library</PackageTags>
		<RepositoryUrl>https://github.com/oznetmaster/KasaTapoClient</RepositoryUrl>
		<PackageProjectUrl>https://github.com/oznetmaster/KasaTapoClient</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>Reusable Kasa/Tapo client library for .NET Framework 4.7.2 and .NET 10.</Description>
		<PackageReleaseNotes># KasaTapoClient 2.2.2

- When a SMART refresh batch times out, retry its reads individually. The device instance keeps using individual core reads on later polls, avoiding a repeated timeout. Caller cancellation still stops the refresh.
- Discover outlets during the first refresh of SMART strips such as the Tapo P300. If a later page is missing, keep the previously published outlet list and report the refresh failure.

This patch preserves the public API, runtime dependencies, and support for .NET 10 and .NET Framework 4.7.2. The release also includes a separate portable symbol package.

Validation passed on the workstation with 180 offline tests per framework and on Crestron processor Mono with all 180 offline tests. The timeout regressions used simulated SMART responses. [Validation record](https://github.com/oznetmaster/KasaTapoClient/blob/v2.2.2/release-validation/v2.2.2.json)

Upstream reference [python-kasa #1759](https://github.com/python-kasa/python-kasa/pull/1759).
</PackageReleaseNotes>
		<!-- brings in System.Net.Http -->
		<LangVersion>13.0</LangVersion>
		<Nullable>enable</Nullable>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
		<!-- Treat missing XML docs as errors in Release -->
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
		<!-- Disable deterministic so timestamps differ (useful if stamping versions externally) -->
		<Deterministic>false</Deterministic>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<Reference Include="System.Configuration" />
		<Reference Include="System.Data.DataSetExtensions" />
		<Reference Include="Microsoft.CSharp" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
		<PackageReference Include="System.Text.Json" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="" />
		<None Include="..\MIGRATION-2.0.md" Pack="true" PackagePath="" />
		<None Include="..\CHANGELOG.md" Pack="true" PackagePath="" />
		<None Include="..\RELEASE_NOTES.md" Pack="true" PackagePath="" />
		<None Include="..\KasaClient.Tests\README.md" Pack="true" PackagePath="KasaClient.Tests/" />
		<None Include="..\LICENSE" Pack="true" PackagePath="" />
		<None Include="..\ATTRIBUTIONS.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="KasaClient.Tests" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<PackageReference Include="IsExternalInit" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
		<PackageReference Include="System.Memory" Version="4.6.3" />
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Properties\" />
	</ItemGroup>

	<!-- Detect docfx.exe from docfx.console package or global dotnet tool -->
	<Choose>
		<When Condition="Exists('$(USERPROFILE)\.dotnet\tools\docfx.exe')">
			<PropertyGroup>
				<DocfxExe>$(USERPROFILE)\.dotnet\tools\docfx.exe</DocfxExe>
			</PropertyGroup>
		</When>
		<When Condition="Exists('C:\ProgramData\chocolatey\bin\docfx.exe')">
			<PropertyGroup>
				<DocfxExe>C:\ProgramData\chocolatey\bin\docfx.exe</DocfxExe>
			</PropertyGroup>
		</When>
		<When Condition="Exists('$(Pkgdocfx_console)\tools\docfx.exe')">
			<PropertyGroup>
				<DocfxExe>$(Pkgdocfx_console)\tools\docfx.exe</DocfxExe>
			</PropertyGroup>
		</When>
		<Otherwise>
			<PropertyGroup>
				<DocfxExe></DocfxExe>
			</PropertyGroup>
		</Otherwise>
	</Choose>

	<Target Name="GenerateDocfxDoc" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net472'">
		<PropertyGroup>
			<DocsDir>$(MSBuildProjectDirectory)\docs</DocsDir>
			<DocfxConfig>$(MSBuildProjectDirectory)\docfx\docfx.json</DocfxConfig>
		</PropertyGroup>

		<Warning Text="DOCFX: DocFX not found. Skipping docs." Condition="'$(DocfxExe)' == ''" />
		<Warning Text="DOCFX: docfx.json not found at '$(DocfxConfig)'. Skipping docs." Condition="'$(DocfxExe)' != '' and !Exists('$(DocfxConfig)')" />

		<!--1) Metadata -->
		<Message Importance="high" Text="DOCFX: Generating metadata from $(DocfxConfig)" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />
		<Exec Command="&quot;$(DocfxExe)&quot; metadata &quot;$(DocfxConfig)&quot;" ContinueOnError="true" IgnoreExitCode="true" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />

		<!--2) Build site directly into docs -->
		<Message Importance="high" Text="DOCFX: Building site to $(DocsDir)" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />
		<RemoveDir Directories="$(DocsDir)" Condition="Exists('$(DocsDir)')" />
		<MakeDir Directories="$(DocsDir)" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />
		<Exec Command="&quot;$(DocfxExe)&quot; build &quot;$(DocfxConfig)&quot; --output &quot;$(DocsDir)&quot; --logLevel Error --noLangKeyword true --markdownEngineName markdig" ContinueOnError="true" IgnoreExitCode="true" Condition="'$(DocfxExe)' != '' and Exists('$(DocfxConfig)')" />

	</Target>
  <!-- Shared strict XML documentation policy: all configurations and target frameworks. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1658;CS1710;CS1711;CS1712</WarningsAsErrors>
  </PropertyGroup>
  <Import Project="../build/LibrarySymbols.props" />
</Project>
